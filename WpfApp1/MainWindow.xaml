<Window x:Class="WpfApp1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WPF Greeting" Height="240" Width="460"
        MinHeight="220" MinWidth="320" WindowStartupLocation="CenterScreen">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Label Content="_Username" Target="{Binding ElementName=UsernameTextBox}" Padding="0,0,0,6" />
        <TextBox x:Name="UsernameTextBox" Grid.Row="1"
                 AutomationProperties.Name="Username"
                 TextChanged="TextBox_TextChanged" />
        <Button x:Name="GreetButton" Grid.Row="2" Content="_Greet"
                HorizontalAlignment="Left" Padding="16,5" Margin="0,12,0,12"
                IsDefault="True" IsEnabled="False" Click="Button_Click" />
        <TextBlock x:Name="GreetingTextBlock" Grid.Row="3" TextWrapping="Wrap" />
    </Grid>
</Window>
